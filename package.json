{
  "name": "pandas-dojo",
  "productName": "Dojo",
  "version": "1.4.0",
  "description": "Dojo: practice pandas, SQL and Excel interview questions, fully offline.",
  "author": {
    "name": "Dojo",
    "email": "khushalsinhmar@gmail.com"
  },
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "prepare-renderer": "node scripts/prepare-renderer.mjs",
    "fetch-pyodide": "node scripts/fetch-pyodide.mjs",
    "icons": "electron scripts/make-icons.cjs",
    "build:ts": "tsc -p tsconfig.json",
    "build": "npm run prepare-renderer && npm run build:ts",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "test:smoke": "node scripts/smoke-test.mjs",
    "build:pandas-lc": "node scripts/build-pandas-lc.mjs",
    "verify:sql": "node scripts/verify-sql.mjs",
    "verify:excel": "node scripts/verify-excel.mjs",
    "test:excel": "node scripts/test-excel-engine.mjs",
    "predist": "npm run build",
    "dist": "electron-builder --win --mac --linux --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "release:win": "npm run build && electron-builder --win --publish always",
    "release:mac": "npm run build && electron-builder --mac --publish always",
    "release:linux": "npm run build && electron-builder --linux --publish always"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.55.0",
    "png2icons": "^2.0.1",
    "sql.js": "^1.15.2",
    "typescript": "^5.9.3",
    "xlsx": "^0.18.5"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
